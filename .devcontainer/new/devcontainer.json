{
  "image": "ubuntu:resolute-20260912",
  "features": {
    "ghcr.io/wxw-matt/devcontainer-features/command_runner:0.5.0": {
      "command1": "apt update",
      "command2": "apt install --no-install-recommends -y --allow-remove-essential coreutils-from-uutils- bc cmake cpio file git qemu-utils sudo",
      "command3": "rm -rf /var/lib/apt/lists/*",

      "command4": "echo 'ubuntu ALL=(root) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu",
      "command5": "chmod 440 /etc/sudoers.d/ubuntu"
    }
  },

  "workspaceFolder": "/workspaces/asdfgh",
  "workspaceMount": "type=bind,src=${localWorkspaceFolder},dst=${containerWorkspaceFolder}",

  "remoteUser": "ubuntu",
  //"containerEnv": {
  //  "TERM": "xterm-256color"
  //}
}
